# Auto-generated by wp-light. Do not edit by hand — regenerate via
# `wplight regen-config {{SITE_NAME}}` instead, or your changes will be lost.

server {
    listen       {{HTTP_PORT}};
    server_name  {{DOMAIN}};
    root         "{{SITE_ROOT}}";
    index        index.php index.html;

    access_log   "{{LOG_DIR}}/{{SITE_NAME}}.access.log";
    error_log    "{{LOG_DIR}}/{{SITE_NAME}}.error.log";

    client_max_body_size 512M;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_pass   127.0.0.1:{{PHP_FPM_PORT}};
        fastcgi_index  index.php;
        include        fastcgi_params;
        fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|svg)$ {
        expires 7d;
        access_log off;
    }

    location ~ /\.ht {
        deny all;
    }
}
